# =============================================================================
# Copy to .env and fill values. Never commit .env.
# OPTION_WATCHLIST symbols MUST start with TRADE_SYMBOL (e.g. SPX + SPX...).
# Docs: https://developer.webull.com/apis/docs/
#
# Deployment order (see DEPLOY.md):
#   1) WEBULL_PAPER + TRADING_ENABLED=false → paste Webull + Claude keys + real OPTION_WATCHLIST
#   2) python scripts/check_env_ready.py → start uvicorn → preflight ready → then enable trading
#   3) WEBULL_LIVE only after paper is stable (explicit .env change)
# =============================================================================

# SIM | WEBULL_PAPER | WEBULL_LIVE
APP_MODE=WEBULL_PAPER

DATABASE_URL=sqlite:///./wetrade.db

# HTTP API: require X-API-Key on all routes except GET /api/health (recommended when not localhost-only)
REQUIRE_API_KEY=false
# Long random string; sent as header: X-API-Key: <value>
API_ADMIN_KEY=

# Master kill-switch: false until preflight passes
TRADING_ENABLED=false

# Underlying for signals (5m bars). SPX or SPY — must match your options list prefix.
TRADE_SYMBOL=SPX

# Anthropic API (confidence/chop only; does not bypass risk)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Webull OpenAPI (Trading + Market Data for your account)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_OPENAPI_DOMAIN=https://openapi.webull.com
WEBULL_REGION_ID=us

# Comma-separated option symbols Webull recognizes (same underlying as TRADE_SYMBOL)
# Replace with real SPX option symbols from your chain / broker format
OPTION_WATCHLIST=SPX250106C00600000,SPX250106P00590000

# Loop intervals (seconds)
SIGNAL_LOOP_SECONDS=60
MONITOR_LOOP_SECONDS=10
ORDER_TIMEOUT_SECONDS=20

# Session guard (exchange local time assumptions; adjust if needed)
MARKET_OPEN_TIME=09:30
MARKET_CLOSE_TIME=16:00
NO_TRADE_FIRST_MINUTES=10
NO_TRADE_LAST_MINUTES=20

# Risk caps ($100/day profit stop — raise only if you intend larger daily target)
MAX_TRADES_PER_DAY=3
MAX_DAILY_LOSS=150
MAX_DAILY_PROFIT=100
MAX_LOSS_PER_TRADE_PCT=0.25
TAKE_PROFIT_PCT=0.40
TRAIL_ACTIVATION_PCT=0.20
MAX_CONSECUTIVE_LOSSES=2

# LLM entry quality (0 = disabled; use ~0.55+ with CLAUDE_API_KEY in production)
MIN_ENTRY_CONFIDENCE=0.55
CHOP_BLOCKS_ENTRY=true

# Option mark drops >= this fraction vs prior tick → emergency flat (0 = off)
SUDDEN_OPTION_DROP_PCT=0.12
